# ===== Lo que NO se versiona en Git =====

# Datos: pesados y con informacion personal, se versionan con DVC en S3
data/*
!data/*.dvc
!data/PROVENANCE.md
*.csv
*.parquet
*.db

# Modelos entrenados
models/*
!models/.gitkeep
*.pkl

# Secretos y credenciales
.env
.env.*

# Estado de Terraform
*.tfstate
*.tfstate.*
.terraform/

# Notebooks con salidas y entornos locales
.ipynb_checkpoints/
*.ipynb
venv/
__pycache__/
.pytest_cache/